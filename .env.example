# Copy to .env.local for local development.
# Local preview accepts admin/admin and contains no business data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Private server-only token for Mercado Pago Pix payments. Never use NEXT_PUBLIC_.
MP_ACCESS_TOKEN=
# Private Gemini API key for chat and financial summaries. Never use NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
